# ---------------------------------------------------------------------------
# Modele de configuration d'environnement pour la pile Docker Compose.
#
# Ce fichier ne contient QUE des valeurs de demonstration. Ne l'utilisez jamais
# tel quel en production : remplacez chaque valeur. Copiez-le en `.env` pour
# surcharger la pile (docker compose -f docker-compose.ecom.yml ... lit `.env`).
# Le fichier `.env` reel ne doit JAMAIS etre versionne.
# ---------------------------------------------------------------------------

# --- PostgreSQL (product/customer) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
PRODUCT_DB_PASSWORD=change-me
CUSTOMER_DB_PASSWORD=change-me

# --- MinIO (stockage objet S3 des images produit) ---
MINIO_ROOT_USER=pfeecom
MINIO_ROOT_PASSWORD=change-me
MINIO_APP_ACCESS_KEY=pfeecom-app
MINIO_APP_SECRET_KEY=change-me
MINIO_BUCKET=pfeecom-product-images

# --- Keycloak (realm pfeecom) ---
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change-me
KEYCLOAK_HOSTNAME=http://localhost:8181
# Secret du compte de service de provisionnement (cote serveur uniquement).
PROVISIONER_CLIENT_SECRET=change-me
# Mots de passe des utilisateurs de demonstration importes avec le royaume.
KEYCLOAK_DEMO_ADMIN_PASSWORD=change-me
KEYCLOAK_DEMO_CUSTOMER_PASSWORD=change-me
KEYCLOAK_DEMO_CUSTOMER2_PASSWORD=change-me

# --- Grafana ---
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me

# --- Surcharges optionnelles des services ---
# SPRING_DATA_MONGODB_URI=mongodb://mongo:27017/pfe_carts
# ELASTICSEARCH_URIS=http://elasticsearch:9200
# EUREKA_CLIENT_SERVICEURL_DEFAULTZONE=http://discovery:8761/eureka
# KEYCLOAK_ISSUER_URI=http://localhost:8181/realms/pfeecom
